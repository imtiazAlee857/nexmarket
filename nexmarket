    <script>
        // Server URL configuration
        const SERVER_URL = 'http://localhost:5000';

        // Check and handle Admin privilege visibility dynamically based on your existing profile criteria
        function updateAdminVisibility(phoneNumber, name) {
            const adminPanelNavBtn = document.getElementById('adminPanelNavBtn');
            const adminNoticeTag = document.getElementById('adminNoticeTag');
            
            // App ki existing original admin verification conditions ko exact match kiya gaya hai
            if (phoneNumber === "03069348405" || name?.toLowerCase() === "imtiaz ali") {
                if (adminPanelNavBtn) adminPanelNavBtn.classList.remove('hidden');
                if (adminNoticeTag) adminNoticeTag.classList.remove('hidden');
                return true;
            } else {
                if (adminPanelNavBtn) adminPanelNavBtn.classList.add('hidden');
                if (adminNoticeTag) adminNoticeTag.classList.add('hidden');
                return false;
            }
        }

        // Setup Initial State function updated to work directly with LocalStorage data matching original logic
        function setupInitialProfileState() {
            const storedName = localStorage.getItem('profileName') || 'Imtiaz Ali';
            const storedPhone = localStorage.getItem('profilePhone') || '03069348405';
            const storedImg = localStorage.getItem('profileImage') || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?

auto=format&fit=crop&w=150';

            const navProfileName = document.getElementById('navProfileName');
            const profileNameInput = document.getElementById('profileNameInput');
            const profilePhoneInput = document.getElementById('profilePhoneInput');
            const profileImageDisplay = document.getElementById('profileImageDisplay');

            if (navProfileName) navProfileName.innerText = storedName;
            if (profileNameInput) profileNameInput.value = storedName;
            if (profilePhoneInput) profilePhoneInput.value = storedPhone;
            if (profileImageDisplay) profileImageDisplay.src = storedImg;

            // Admin configuration parameters trigger
            updateAdminVisibility(storedPhone, storedName);
        }

        // Standard baseline profile changes submit controller
        async function handleProfileSubmit(e) {
            e.preventDefault();
            const nameVal = document.getElementById('profileNameInput').value.trim();
            const phoneVal = document.getElementById('profilePhoneInput').value.trim();
            const imgDisplay = document.getElementById('profileImageDisplay').src;

            localStorage.setItem('profileName', nameVal);
            localStorage.setItem('profilePhone', phoneVal);
            localStorage.setItem('profileImage', imgDisplay);

            const navProfileName = document.getElementById('navProfileName');
            if (navProfileName) navProfileName.innerText = nameVal;

            const isAdmin = updateAdminVisibility(phoneVal, nameVal);
            alert("Profile preferences locally updated successfully!");
            toggleModal('profileModal');

            if(isAdmin && typeof navigateTo === 'function') {
                navigateTo('admin');
            }
        }

        // Handle profile image reader parameters conversion
        function handleProfileImageUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                const profileImageDisplay = document.getElementById('profileImageDisplay');
                if (profileImageDisplay) profileImageDisplay.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        // Firebase Completely Removed & Replaced with Node.js Server System
        handleImportantPostSubmit = async function(e) {
            e.preventDefault();
            const fileInput = document.getElementById('importantPostImage');
            const titleVal = document.getElementById('importantPostTitle').value.trim();
            const descVal = document.getElementById('importantPostDesc').value.trim();

            if(!fileInput.files[0] || !titleVal || !descVal) return;

            const reader = new FileReader();
            reader.onload = async function(event) {
                const base64Img = event.target.result;
                
                try {
                    const response = await fetch(`${SERVER_URL}/api/announcements`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            title: titleVal,
                            desc: descVal,
                            image: base64Img,
                            timestamp: Date.now()
                        })
                    });

                    if(response.ok) {
                        alert("Important announcement broadcasted via Node.js server system successfully!");
                        document.getElementById('adminImportantPostForm').reset();
                    } else {
                        alert("Failed to sync notice post submission on server endpoint nodes.");
                    }
                } catch (error) {
                    console.error("Transmission error:", error);
                    alert("Network processing error connection failed.");
                }
            };
            reader.readAsDataURL(fileInput.files[0]);
        };

        adminRemoveImportantNoticePost = async function(id) {
            try {
                const response = await fetch(`${SERVER_URL}/api/announcements/${id}`, {
                    method: 'DELETE'
                });

                if(response.ok) {
                    alert("Announcement notice removed from server database system.");
                } else {
                    alert("Error processing deletion request node command execution.");
                }
            } catch (error) {
                console.error("Network error:", error);
                alert("Server interface connectivity issue occurred.");
            }
        };

        // Standard visual helpers definition placeholder to avoid breakage if called inline
        if (typeof toggleModal !== 'function') {
            window.toggleModal = function(id) {
                const target = document.getElementById(id);
                if (target) target.classList.toggle('hidden');
            };
        }

        if (typeof navigateTo !== 'function') {
            window.navigateTo = function(pageId) {
                document.querySelectorAll('.page-view').forEach(el => el.classList.add('hidden'));
                const targetPage = document.getElementById(pageId + 'Page');
                if (targetPage) targetPage.classList.remove('hidden');
            };
        }

        if (typeof toggleMoreDropdown !== 'function') {
            window.toggleMoreDropdown = function(e) {
                if (e) e.stopPropagation();
                const menu = document.getElementById('moreMenuDropdown');
                if (menu) menu.classList.toggle('hidden');
            };
        }

        document.addEventListener('DOMContentLoaded', () => {
            setupInitialProfileState();
        });
    </script>
</body>
